# Copy to .env for local development. Real environment files are git-ignored.

# --- Local PostgreSQL container (consumed by compose.yaml) ---
POSTGRES_USER=takehome
POSTGRES_PASSWORD=takehome
POSTGRES_DB=takehome

# --- Application database ---
# postgres = local container via postgres.js; neon = deployed Neon serverless.
DATABASE_DRIVER=postgres
# Must match the container credentials above when DATABASE_DRIVER=postgres.
DATABASE_URL=postgresql://takehome:takehome@localhost:5432/takehome

# --- Auth.js ---
# Generate a value with: openssl rand -base64 32 (validated to be at least 32 characters)
AUTH_SECRET=

# --- Seeded development accounts (non-secret example values, used by db:seed) ---
REVIEWER_USER_EMAIL=reviewer@takehome.local
REVIEWER_USER_PASSWORD=reviewer-password-123
OWNER_USER_EMAIL=owner@takehome.local
OWNER_USER_PASSWORD=owner-password-123
